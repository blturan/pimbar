{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pimbar",
  "identifier": "dev.pimbar.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "pimbar: Azure PIM in the menu bar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 372
        },
        "appPosition": {
          "x": 180,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 150
        }
      },
      "signingIdentity": "-"
    }
  }
}
